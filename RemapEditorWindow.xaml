<Window x:Class="KeyNexus.RemapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeyNexus.ViewModels"
        Title="Personalizar teclas" Height="860" Width="780" MinHeight="640" MinWidth="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <DataTemplate x:Key="RuleTemplate" DataType="{x:Type vm:RemapRuleViewModel}">
            <Border x:Name="row" Padding="12,9" CornerRadius="8" Margin="2" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding TriggerParts}" ToolTip="{Binding TriggerTooltip}"
                                  ItemTemplate="{StaticResource KeyChipTemplate}"
                                  ItemsPanel="{StaticResource HorizontalItemsPanel}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Margin="6,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding OutputTooltip}">
                        <ItemsControl ItemsSource="{Binding OutputParts}"
                                      ItemTemplate="{StaticResource KeyChipTemplate}"
                                      ItemsPanel="{StaticResource HorizontalItemsPanel}"
                                      Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding OutputText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsNotKey, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Warning}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Style="{StaticResource ChipBadge}" Margin="8,0,8,0">
                        <TextBlock Text="{Binding TypeDisplay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLightBrush}"/>
                    </Border>

                    <Button Grid.Column="4" Content="Converter para tecla" Style="{StaticResource SecondaryButton}"
                            Padding="10,5" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"
                            Visibility="{Binding CanConvertToKey, Converter={StaticResource BoolToVis}}"
                            Click="BtnConvertRule_Click" Tag="{Binding}"/>
                    <Button Grid.Column="5" Content="&#xE70F;" Style="{StaticResource IconButton}"
                            ToolTip="Editar" Click="BtnEditRule_Click" Tag="{Binding}"/>
                    <Button Grid.Column="6" Content="&#xE74D;" Style="{StaticResource IconButton}"
                            ToolTip="Excluir" Click="BtnDeleteRule_Click" Tag="{Binding}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTitle" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="txtLayoutHint" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Montagem da regra -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Text="QUANDO EU APERTAR" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCaptureTrigger" Style="{StaticResource CaptureButton}" Click="BtnCaptureTrigger_Click"
                            ToolTip="Clique e aperte a tecla, com Shift, Ctrl, Alt ou AltGr se quiser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}"/>
                            <ItemsControl x:Name="triggerChips" ItemTemplate="{StaticResource KeyChipTemplate}"
                                          ItemsPanel="{StaticResource HorizontalItemsPanel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTriggerPlaceholder" Text="Clique aqui e aperte a tecla"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="cmbTriggerKey" Grid.Column="1" Width="180" Margin="10,0,0,0"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              DisplayMemberPath="Name" ToolTip="Ou escolha a tecla na lista" Tag="ou escolha na lista"
                              SelectionChanged="CmbTriggerKey_SelectionChanged"/>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Junto com:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <ToggleButton x:Name="tglShift" Content="Shift" Style="{StaticResource ModifierToggle}" Click="TriggerModifier_Click"/>
                    <ToggleButton x:Name="tglCtrl" Content="Ctrl" Style="{StaticResource ModifierToggle}" Click="TriggerModifier_Click"/>
                    <ToggleButton x:Name="tglAlt" Content="Alt" Style="{StaticResource ModifierToggle}" Click="TriggerModifier_Click"/>
                    <ToggleButton x:Name="tglAltGr" Content="AltGr" Style="{StaticResource ModifierToggle}" Click="TriggerModifier_Click"/>
                </WrapPanel>

                <TextBlock Text="ENVIAR" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbKey" Content="Tecla" GroupName="OutputType" IsChecked="True"
                                 Style="{StaticResource SegmentedRadio}" Checked="OutputType_Checked"/>
                    <RadioButton x:Name="rbText" Content="Texto" GroupName="OutputType"
                                 Style="{StaticResource SegmentedRadio}" Checked="OutputType_Checked"/>
                    <RadioButton x:Name="rbMacro" Content="Macro (avançado)" GroupName="OutputType"
                                 Style="{StaticResource SegmentedRadio}" Checked="OutputType_Checked"/>
                </StackPanel>
                <TextBlock x:Name="txtTypeHelp" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <Grid x:Name="panelOutputKey" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCaptureOutput" Style="{StaticResource CaptureButton}" Click="BtnCaptureOutput_Click"
                            ToolTip="Clique e aperte a tecla que deve sair">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}"/>
                            <ItemsControl x:Name="outputChips" ItemTemplate="{StaticResource KeyChipTemplate}"
                                          ItemsPanel="{StaticResource HorizontalItemsPanel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOutputPlaceholder" Text="Clique aqui e aperte a tecla que deve sair"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="cmbOutputKey" Grid.Column="1" Width="180" Margin="10,0,0,0"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              DisplayMemberPath="Name" ToolTip="Ou escolha a tecla na lista" Tag="ou escolha na lista"
                              SelectionChanged="CmbOutputKey_SelectionChanged"/>
                </Grid>

                <TextBox x:Name="txtOutputText" Style="{StaticResource TextInput}" Margin="0,12,0,0"
                         Tag="Texto que será digitado" Visibility="Collapsed"/>

                <StackPanel x:Name="panelOutputSequence" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBox x:Name="txtOutputSequence" Style="{StaticResource TextInput}" Tag="Ex.: F1,100; F2,50; A"/>
                    <TextBlock Text="Formato: tecla,atraso em ms. Separe os passos com ponto e vírgula."
                               FontSize="11.5" Margin="2,6,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtBuilderHint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,12,0" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnCancelEdit" Content="Cancelar edição" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancelEdit_Click"/>
                        <Button x:Name="btnAddRule" Content="Adicionar regra" Style="{StaticResource ModernButton}"
                                Click="BtnAddRule_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Regras -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="REGRAS DESTE TECLADO" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="txtRuleCount" FontSize="11.5" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" MinHeight="90">
                <Grid>
                    <TextBlock x:Name="txtNoRules" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="16" Foreground="{StaticResource TextMutedBrush}"
                               Text="Nenhuma regra ainda. Clique em &quot;Quando eu apertar&quot; e aperte a tecla que quer mudar."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="lstRules" ItemTemplate="{StaticResource RuleTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Teste -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="TESTE AQUI" Style="{StaticResource SectionLabel}"/>
            <TextBox x:Name="txtTest" Style="{StaticResource TextInput}"/>
        </StackPanel>

        <!-- Rodapé -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="As mudanças são salvas e valem na hora." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <Button Content="Concluir" Style="{StaticResource ModernButton}" HorizontalAlignment="Right"
                    Click="BtnDone_Click" Width="110"/>
        </Grid>
    </Grid>
</Window>

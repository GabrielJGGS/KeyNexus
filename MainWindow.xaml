<Window x:Class="KeyNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeyNexus.ViewModels"
        Title="KeyNexus" Height="740" Width="900" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <DataTemplate x:Key="LayoutOptionTemplate" DataType="{x:Type vm:LayoutOption}">
            <StackPanel ToolTip="{Binding TechnicalInfo}" Background="Transparent">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="KeyboardCardTemplate" DataType="{x:Type vm:KeyboardItemViewModel}">
            <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do card -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="iconTile" Width="42" Height="42" CornerRadius="10"
                                Background="{StaticResource BgElevatedBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{StaticResource AccentLightBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsNotEditingName, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15.5" FontWeight="SemiBold"
                                           FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Content="&#xE70F;" Style="{StaticResource SmallIconButton}" Margin="6,0,0,0"
                                        ToolTip="Renomear este teclado" Click="BtnRename_Click" Tag="{Binding}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource TextInput}" MaxWidth="340" HorizontalAlignment="Left" MinWidth="220"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Nome do teclado"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                     KeyDown="NameBox_KeyDown" LostFocus="NameBox_LostFocus"
                                     IsVisibleChanged="NameBox_IsVisibleChanged"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="10" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center"
                                Background="{StaticResource SuccessSoftBrush}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Em uso agora" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="3" Content="&#xE712;" Style="{StaticResource IconButton}"
                                ToolTip="Mais opções" Click="BtnMore_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Corpo do card -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="LAYOUT DESTE TECLADO" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AvailableLayouts}"
                                          ItemTemplate="{StaticResource LayoutOptionTemplate}"
                                          SelectedValuePath="Hkl"
                                          SelectedValue="{Binding SelectedLayoutHkl, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="&#xE70F;" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                        ToolTip="Dar um apelido a este layout" Click="BtnLayoutAlias_Click" Tag="{Binding}"
                                        IsEnabled="{Binding HasLayout}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TECLAS PERSONALIZADAS" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RemapSummary}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Grid.Column="1" Content="Personalizar" Style="{StaticResource SecondaryButton}"
                                        Click="BtnRemap_Click" Tag="{Binding}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="card" Property="Background" Value="{StaticResource BgCardActiveBrush}"/>
                    <Setter TargetName="iconTile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SavedKeyboardTemplate" DataType="{x:Type vm:SavedKeyboardViewModel}">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" Opacity="0.85">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Esquecer" Style="{StaticResource GhostButton}"
                            Click="BtnForgetSaved_Click" Tag="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource AccentLightBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}">
                    <Run Text="Key"/><Run Text="Nexus" Foreground="{StaticResource AccentLightBrush}"/>
                </TextBlock>
                <TextBlock Text="Cada teclado com o seu layout" FontSize="12.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtVersion" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <Button x:Name="btnSettings" Content="&#xE713;" Style="{StaticResource IconButton}"
                        ToolTip="Configurações" Click="BtnSettings_Click"/>
            </StackPanel>

            <Popup x:Name="settingsPopup" PlacementTarget="{Binding ElementName=btnSettings}" Placement="Bottom"
                   HorizontalOffset="-276" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Width="310" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Configurações" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="chkAutoStart" Style="{StaticResource ToggleSwitch}"
                                  Content="Iniciar com o Windows" Click="ChkAutoStart_Click" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chkPaused" Style="{StaticResource ToggleSwitch}"
                                  Content="Pausar KeyNexus" Click="ChkPaused_Click"/>
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,14,0,8"/>
                        <StackPanel x:Name="updateSlot"/>
                        <TextBlock x:Name="txtSettingsStatus" FontSize="11.5" Margin="34,0,0,4" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                        <Button Style="{StaticResource GhostButton}" Click="BtnAddLayout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Adicionar layout no Windows"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="BtnReleaseKeys_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Soltar teclas presas"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="BtnOpenLogs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Abrir pasta de logs"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="txtVersionFull" FontSize="11" Margin="10,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Teclado em uso agora -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="12" Height="12" VerticalAlignment="Center">
                    <Ellipse x:Name="liveHalo" Fill="{StaticResource SuccessBrush}" Opacity="0.25"/>
                    <Ellipse x:Name="liveDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="txtLiveTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtLiveSubtitle" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KeyNexus pausado -->
        <Border Grid.Row="2" x:Name="pausedBanner" Visibility="Collapsed" CornerRadius="10" Padding="14,10"
                Margin="0,0,0,12" Background="{StaticResource WarningSoftBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="KeyNexus pausado: a troca de layout e as teclas personalizadas estão desligadas."
                           FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource WarningBrush}"/>
                <Button Grid.Column="1" Content="Retomar" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="BtnResume_Click"/>
            </Grid>
        </Border>

        <!-- Primeiro uso -->
        <Border Grid.Row="3" x:Name="onboarding" Visibility="Collapsed" Style="{StaticResource Card}"
                Padding="18,16" Margin="0,0,0,12" BorderBrush="{StaticResource AccentDimBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Como configurar" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentLightBrush}"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Digite no teclado" FontWeight="SemiBold"/>
                                <TextBlock Text="ele acende na lista" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentLightBrush}"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Escolha o layout" FontWeight="SemiBold"/>
                                <TextBlock Text="com o nome do Windows" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentLightBrush}"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Pronto" FontWeight="SemiBold"/>
                                <TextBlock Text="o KeyNexus troca sozinho" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <Button Grid.Column="1" Content="Entendi" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnDismissOnboarding_Click"/>
            </Grid>
        </Border>

        <!-- Lista -->
        <ScrollViewer Grid.Row="4" x:Name="scroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <Grid Margin="0,4,0,10">
                    <TextBlock Text="TECLADOS CONECTADOS" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <TextBlock Text="Aperte uma tecla em qualquer teclado para identificá-lo" FontSize="11.5"
                               HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>

                <TextBlock x:Name="txtEmpty" Text="Procurando teclados..." Margin="2,8,0,16"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <ItemsControl x:Name="lstKeyboards" ItemTemplate="{StaticResource KeyboardCardTemplate}"/>

                <StackPanel x:Name="savedSection" Visibility="Collapsed" Margin="0,6,0,8">
                    <ToggleButton x:Name="tglSaved" Style="{StaticResource ExpanderToggle}">
                        <TextBlock x:Name="txtSavedHeader" Text="Teclados salvos"/>
                    </ToggleButton>
                    <TextBlock Text="Configurações guardadas de teclados que não estão conectados agora."
                               FontSize="11.5" Margin="30,0,0,8" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsChecked, ElementName=tglSaved, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl x:Name="lstSaved" ItemTemplate="{StaticResource SavedKeyboardTemplate}"
                                  Visibility="{Binding IsChecked, ElementName=tglSaved, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
